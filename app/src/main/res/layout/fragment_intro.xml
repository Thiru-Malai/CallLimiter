<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="40dp"
    android:gravity="center">

    <!-- App Logo -->
    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo___notification"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="40dp"
        app:tint="?attr/colorPrimary" />

    <!-- App Name -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/textAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="38sp"
        android:fontFamily="@font/alegreya_semibold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="28dp"/>

    <!-- About Description -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/textAboutApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/take_control_of_your_phone_calls_by_setting_duration_limits_and_managing_your_time_more_efficiently"
        android:textSize="18sp"
        android:lineSpacingExtra="8dp"
        android:textAlignment="center"/>

</LinearLayout>
